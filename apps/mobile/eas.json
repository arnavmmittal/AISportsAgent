{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_URL": "http://localhost:3000"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_URL": "https://flowsportscoach-git-staging-arnav-mittals-projects-f6d6791a.vercel.app",
        "EXPO_PUBLIC_SUPABASE_URL": "https://ccbcrerrnkqqgxtlqjnm.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "ROTATE_ME"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://app.flowsportscoach.com",
        "EXPO_PUBLIC_SUPABASE_URL": "https://ccbcrerrnkqqgxtlqjnm.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "ROTATE_ME"
      }
    },
    "ios-simulator": {
      "distribution": "internal",
      "channel": "staging",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_URL": "https://flowsportscoach-git-staging-arnav-mittals-projects-f6d6791a.vercel.app",
        "EXPO_PUBLIC_SUPABASE_URL": "https://ccbcrerrnkqqgxtlqjnm.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "ROTATE_ME"
      }
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      }
    },
    "production": {
      "ios": {
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      }
    }
  }
}
